{
  "name": "@jeangnc/tenets",
  "version": "0.0.0",
  "description": "Whole-graph checks for jeangnc's coding tenets: hooks and components sit under their nearest owner",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeangnc/tenets.git",
    "directory": "js/packages/placement"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "typescript": ">=5.9 <6.1"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
